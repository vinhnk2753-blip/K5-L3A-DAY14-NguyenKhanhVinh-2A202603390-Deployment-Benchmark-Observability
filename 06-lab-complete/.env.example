# Copy thành .env khi chạy local (KHÔNG commit file .env)
PORT=8000
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Thay bằng chuỗi bí mật ngẫu nhiên trên môi trường thật
AGENT_API_KEY=change-me-to-a-strong-secret

# Redis lưu state cho rate limiting & cost guard
REDIS_URL=redis://localhost:6379/0

# Bảo vệ tốc độ & ngân sách LLM
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
